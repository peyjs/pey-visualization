{
  "name": "pey.visualization",
  "version": "1.0.0",
  "type": "module",
  "description": "Data visualization service: independent charts drawn from host-prepared data over a hidden chart renderer (Observable Plot behind an internal adapter)",
  "exports": {
    ".": "./index.js",
    "./manifest.json": "./manifest.json",
    "./lib/constants.js": "./lib/constants.js",
    "./lib/error.js": "./lib/error.js",
    "./lib/visualization-service.js": "./lib/visualization-service.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "files": [
    "manifest.json",
    "index.js",
    "lib/",
    "adapters/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "pey",
    "visualization",
    "charts",
    "plot",
    "bonyan"
  ],
  "license": "MIT",
  "dependencies": {
    "@observablehq/plot": "^0.6.18"
  }
}
